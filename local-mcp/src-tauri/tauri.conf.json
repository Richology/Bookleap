{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "书跃本地同步助手",
  "version": "0.1.0-trial.4",
  "identifier": "cn.bookleap.local",
  "build": {"frontendDist": "frontend", "beforeBuildCommand": "node scripts/prepare-webview.mjs", "beforeDevCommand": "node scripts/prepare-webview.mjs"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"书跃本地同步助手","width":980,"height":720,"minWidth":820,"minHeight":600}],
    "security": {"csp":"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost", "capabilities":[{"identifier":"desktop","windows":["main"],"permissions":["core:event:allow-listen","core:event:allow-unlisten","clipboard-manager:allow-write-text"]}]}
  },
  "bundle": {
    "active":true, "targets":["app","nsis"], "resources":{"runtime/":"runtime/"},
    "macOS":{"signingIdentity":"-"},
    "windows":{"webviewInstallMode":{"type":"downloadBootstrapper","silent":true},"nsis":{"installMode":"currentUser"}},
    "icon":["icons/icon.png","icons/icon.ico","icons/icon.icns"]
  },
  "plugins":{"deep-link":{"desktop":{"schemes":["bookleap-local"]}}}
}
