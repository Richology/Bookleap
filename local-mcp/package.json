{
  "name": "bookleap-local-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop.cjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "electron .",
    "mcp": "node src/mcp.mjs",
    "pack": "electron-builder --dir",
    "dist": "node scripts/release-check.mjs && electron-builder --publish never"
  },
  "dependencies": {
