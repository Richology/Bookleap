{
  "name": "bookleap-local-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop.cjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "tauri dev",
    "mcp": "node src/mcp.mjs",
    "pack": "tauri build --no-bundle",
    "dist": "node scripts/release-check.mjs && electron-builder --publish never",
    "trial:mac": "node scripts/package-webview.mjs",
    "trial:win": "node scripts/package-webview.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0"
  },
  "description": "BookLeap local library sync and read-only MCP",
  "overrides": {
    "minimatch": "11.0.1"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Richology/Bookleap.git"
  },
  "optionalDependencies": {
    "node-bin-darwin-arm64": "22.23.5",
    "node-win-x64": "22.23.5"
  }
}
