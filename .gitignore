# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

uploads/
# Local MCP runtime/build artifacts (never commit user libraries)
/local-mcp/node_modules/
/local-mcp/dist/
/local-mcp/.test-data/
/local-mcp/release-config.json

/local-mcp/dist-smoke/
/local-mcp/safari/build/
**/xcuserdata/

/local-mcp/dist-renamed/
/local-mcp/dist-desktop-ui/
/local-mcp/dist-agent-ui/
